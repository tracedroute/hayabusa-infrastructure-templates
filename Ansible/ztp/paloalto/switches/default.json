{
  "device_type": "switch",
  "vendor": "paloalto",
  "config_template": "panos-switch",
  "pnp_server": "pnpserver.local",
  "tftp_root": "/var/lib/peregrine/ztp/tftp",
  "configuration": {
    "system": {
      "hostname": "paloalto-switch-ztp",
      "domain": "local",
      "update_schedule": {
        "enabled": true,
        "recurrence": "daily",
        "time": "02:00"
      }
    },
    "network": {
      "vlans": [
        {
          "name": "default",
          "vlan_id": 1
        },
        {
          "name": "data",
          "vlan_id": 10
        },
        {
          "name": "voice",
          "vlan_id": 20
        }
      ],
      "interfaces": [
        {
          "name": "ethernet1/1",
          "mode": "access",
          "access_vlan": "data",
          "description": "Data Port 1"
        },
        {
          "name": "ethernet1/2",
          "mode": "access",
          "access_vlan": "voice",
          "description": "Voice Port 1"
        },
        {
          "name": "ethernet1/24",
          "mode": "trunk",
          "allowed_vlans": ["default", "data", "voice"],
          "description": "Uplink Trunk"
        }
      ],
      "layer3_interfaces": [
        {
          "name": "vlan10",
          "ip": "192.168.10.1",
          "netmask": "255.255.255.0",
          "description": "Data VLAN Interface"
        },
        {
          "name": "vlan20",
          "ip": "192.168.20.1",
          "netmask": "255.255.255.0",
          "description": "Voice VLAN Interface"
        }
      ]
    },
    "security": {
      "zones": [
        {
          "name": "trust",
          "interfaces": ["ethernet1/1", "ethernet1/2"]
        },
        {
          "name": "untrust",
          "interfaces": []
        }
      ],
      "rules": [
        {
          "name": "inter-zone-allow",
          "from": "trust",
          "to": "trust",
          "action": "allow",
          "description": "Allow intra-zone traffic"
        }
      ]
    }
  }
}
